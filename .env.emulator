# `npm run dev:emulator` — the website against the LOCAL Firebase emulators
# (start them first with `npm run emulators`). Demo values only, no secrets.
VITE_REGISTRATION_OPEN=true
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-cubyc
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-cubyc.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
