rules_version = '2';

// CUBYC Fest 2027 — Firestore security rules (Spark plan: no server code, the
// rules enforce everything).
//
//   users/{uid}        a participant's account: created once by its owner on first
//                      Google sign-in; email and CUBYC ID can never change.
//   cubycIds/{id}      one document per CUBYC ID, so no two accounts share one.
//   roles/{email}      admin access: { role: 'admin' | 'superadmin', depts }.
//                      Only super admins can grant or remove it. The root super
//                      admin below is built into the rules.
//   auditLogs/{id}     who changed what (append-only).
//
// Anything not listed is closed.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who is asking ------------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function viaGoogle() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function myEmail() { return request.auth.token.email.lower(); }

    // The root super admin(s): cannot be removed from inside the site.
    function isRoot() { return viaGoogle() && myEmail() in ['chiranjeevi.p@bcah.christuniversity.in']; }
    function roleDoc() { return /databases/$(database)/documents/roles/$(myEmail()); }
    function myRole() { return exists(roleDoc()) ? get(roleDoc()).data.role : ''; }
    function isSuperAdmin() { return isRoot() || (viaGoogle() && myRole() == 'superadmin'); }
    function isAdmin() { return isSuperAdmin() || (viaGoogle() && myRole() == 'admin'); }

    // ---- The profile ----------------------------------------------------------------
    function filled(p, k) { return k in p && p[k] is string && p[k].matches('.*[^ ].*'); }
    function text(p, k, max) { return !(k in p) || (p[k] is string && p[k].size() <= max); }
    function phone(p, k) { return !(k in p) || (p[k] is string && (p[k] == '' || p[k].matches('^[6-9][0-9]{9}$'))); }
    function oneOf(p, k, opts) { return !(k in p) || p[k] == '' || p[k] in opts; }
    function dateOk(p) {
      return !('dob' in p) || (p.dob is string && (p.dob == '' || p.dob.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')));
    }

    function validProfile(p) {
      return p is map
        && p.keys().hasOnly(['name', 'gender', 'dob', 'phone', 'whatsapp', 'college', 'department', 'course', 'year',
                             'collegeId', 'city', 'state', 'emergencyName', 'emergencyPhone', 'agree'])
        && text(p, 'name', 80) && text(p, 'college', 120) && text(p, 'department', 80) && text(p, 'course', 60)
        && text(p, 'collegeId', 40) && text(p, 'city', 60) && text(p, 'state', 60) && text(p, 'emergencyName', 80)
        && oneOf(p, 'gender', ['Female', 'Male', 'Non-binary', 'Prefer not to say'])
        && oneOf(p, 'year', ['1st year', '2nd year', '3rd year', '4th year', '5th year', 'Postgraduate'])
        && dateOk(p) && phone(p, 'phone') && phone(p, 'whatsapp') && phone(p, 'emergencyPhone')
        && (!('agree' in p) || p.agree is bool);
    }

    // Every required detail filled in, phones and date well-formed, terms accepted.
    // (Keep in step with src/lib/fest/profile.js.)
    function complete(p) {
      return filled(p, 'name') && filled(p, 'gender') && filled(p, 'dob') && filled(p, 'phone')
        && filled(p, 'college') && filled(p, 'department') && filled(p, 'course') && filled(p, 'year')
        && filled(p, 'collegeId') && filled(p, 'city') && filled(p, 'state')
        && filled(p, 'emergencyName') && filled(p, 'emergencyPhone')
        && 'agree' in p && p.agree == true;
    }

    function validCubycId(id) { return id is string && id.matches('^CB27-[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{6}$'); }

    // ---- Participants -------------------------------------------------------------------
    match /users/{uid} {
      allow read: if (viaGoogle() && request.auth.uid == uid) || isAdmin();

      // First sign-in: your own account, exactly these fields, your verified Google email,
      // and a fresh CUBYC ID claimed in the same write (see cubycIds below).
      allow create: if viaGoogle() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'cubycId', 'profile', 'profileComplete', 'status', 'pass', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == myEmail()
        && validCubycId(request.resource.data.cubycId)
        && getAfter(/databases/$(database)/documents/cubycIds/$(request.resource.data.cubycId)).data.uid == uid
        && validProfile(request.resource.data.profile)
        && request.resource.data.profileComplete == complete(request.resource.data.profile)
        && request.resource.data.status == 'active'
        && request.resource.data.pass == { 'status': 'none' }
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // You may change only your profile (never email, CUBYC ID, status or pass), while active.
      // profileComplete must be the truth about the profile.
      allow update: if viaGoogle() && request.auth.uid == uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile', 'profileComplete', 'updatedAt'])
        && validProfile(request.resource.data.profile)
        && request.resource.data.profileComplete == complete(request.resource.data.profile)
        && request.resource.data.updatedAt == request.time;

      // Super admins: correct a profile or suspend / reactivate an account (logged).
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile', 'profileComplete', 'status', 'updatedAt'])
        && validProfile(request.resource.data.profile)
        && request.resource.data.profileComplete == complete(request.resource.data.profile)
        && request.resource.data.status in ['active', 'suspended']
        && request.resource.data.updatedAt == request.time;

      allow delete: if isSuperAdmin();
    }

    // One document per CUBYC ID. You can claim one only together with creating your
    // account, and you can see only your own (so IDs can't be listed or harvested).
    match /cubycIds/{id} {
      allow get: if viaGoogle() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if viaGoogle() && validCubycId(id)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.cubycId == id;
      allow delete: if isSuperAdmin();
      allow list, update: if false;
    }

    // ---- Admin access -------------------------------------------------------------------
    match /roles/{email} {
      allow get: if viaGoogle() && (myEmail() == email || isSuperAdmin());
      allow list: if isSuperAdmin();
      // Only super admins grant or remove access — never their own, never a root super admin's.
      allow create, update: if isSuperAdmin() && email != myEmail() && email == email.lower()
        && !(email in ['chiranjeevi.p@bcah.christuniversity.in'])
        && request.resource.data.keys().hasOnly(['role', 'depts', 'grantedBy', 'grantedAt'])
        && request.resource.data.role in ['admin', 'superadmin']
        && request.resource.data.depts is list && request.resource.data.depts.size() <= 10
        && request.resource.data.grantedBy == myEmail()
        && request.resource.data.grantedAt == request.time;
      allow delete: if isSuperAdmin() && email != myEmail();
    }

    // Append-only record of admin actions.
    match /auditLogs/{id} {
      allow read: if isSuperAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'target', 'details', 'at'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == myEmail()
        && request.resource.data.action is string && request.resource.data.action.size() <= 60
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // =====================================================================================
    // Event registration
    //
    //   settings/registration         { open } — super admins open and close registration
    //   registrations/{slug}_{uid}     one per person per event (so never twice for one event)
    //   busy/{uid}_{block}             the clash guard: one person, one time block, one event
    //   teams/{TM-XXXXXX}              a team; its ID is the code members join with
    //   teamNames/{slug}_{name}        team names are unique within each event
    //
    // A booking (registration + its busy blocks) is written in one go and checked
    // together. A block already booked can't be booked again, so two events at the
    // same time can never both be held — whether individually or in teams.
    // Participants must have completed their details first.
    // =====================================================================================

    // <events> — generated by scripts/build-rules.mjs from the schedule; do not edit by hand
    function EVENTS() {
      return {
        '6-hour-filmithon': 't,5,d1-1030,d1-1315,d1-1400,d1-1430',
        'air-crash': 'i,1,d1-1030',
        'auction-sudoku': 't,3,d2-1330',
        'battle-of-bands-indian': 't,10,d2-1330',
        'battle-of-bands-western': 't,9,d1-1030',
        'best-manager-sustainaquest': 'i,1,d1-1030',
        'brain-to-brand-pitching-event': 't,3,d1-1030',
        'bulls-and-bears-mock-stock': 't,3,d2-1330',
        'capture-the-assets': 't,8,d2-1330',
        'case-404': 't,6,d1-1030',
        'clash-of-councils': 't,8,d2-0900,d2-0930,d2-1215',
        'convince-the-time-keeper': 't,2,d2-0930',
        'crack-the-psyche': 't,3,d2-1330',
        'creative-curveball': 't,4,d2-0900,d2-0930,d2-1215',
        'cybertronian-wars-gaming': 't,5,d1-1430',
        'escape-room': 't,2,d1-1430,d1-1715',
        'indian-film-and-folk-dance-solo': 'i,1,d1-1430',
        'indian-group-dance-non-theme': 't,15,d2-0930',
        'literature-court-room': 't,3,d1-1030',
        'meme-battle': 't,3,d2-0930',
        'mime': 't,8,d2-0930',
        'monomatics': 't,3,d1-1400,d1-1430,d1-1715',
        'percepta-hr': 't,2,d2-0930',
        'plot-twist-pop-culture-quiz': 't,3,d1-1430',
        'prime-prompt-ai-battle-of-prompts': 't,2,d1-1030,d1-1315,d1-1400,d1-1430',
        'street-play': 't,25,d1-1030',
        'transwarp-protocol-capture-the-flag': 't,3,d2-1330',
      };
    }
    // </events>

    function settingsDoc() { return /databases/$(database)/documents/settings/registration; }
    function regOpen() { return exists(settingsDoc()) && get(settingsDoc()).data.open == true; }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function me() { return get(userDoc(request.auth.uid)).data; }
    // Signed in with Google, active account, details complete.
    function eligible() { return viaGoogle() && exists(userDoc(request.auth.uid)) && me().status == 'active' && me().profileComplete == true; }
    function myEntry() { return { 'uid': request.auth.uid, 'cubycId': me().cubycId, 'name': me().profile.name }; }

    function regPath(slug, uid) { return /databases/$(database)/documents/registrations/$(slug + '_' + uid); }
    function busyPath(uid, block) { return /databases/$(database)/documents/busy/$(uid + '_' + block); }
    function teamPath(id) { return /databases/$(database)/documents/teams/$(id); }
    function namePath(slug, key) { return /databases/$(database)/documents/teamNames/$(slug + '_' + key); }

    // One event from the table: ['t' | 'i', max team size, block, block…]; [''] if there's no such event.
    function ev(slug) { return EVENTS().get(slug, '').split(','); }
    function isEvent(e) { return e.size() >= 3; }
    function isTeamEvent(e) { return isEvent(e) && e[0] == 't'; }

    // After this write, block i of the event is booked by this person for this event (events span ≤ 4 blocks).
    function bookedAfter(uid, slug, e, i) {
      return e.size() <= i + 2 || (existsAfter(busyPath(uid, e[i + 2])) && getAfter(busyPath(uid, e[i + 2])).data.slug == slug);
    }
    function allBookedAfter(uid, slug, e) {
      return bookedAfter(uid, slug, e, 0) && bookedAfter(uid, slug, e, 1) && bookedAfter(uid, slug, e, 2) && bookedAfter(uid, slug, e, 3);
    }
    function freedAfter(uid, e, i) {
      return e.size() <= i + 2 || !existsAfter(busyPath(uid, e[i + 2]));
    }
    function allFreedAfter(uid, slug) {
      let e = ev(slug);
      return freedAfter(uid, e, 0) && freedAfter(uid, e, 1) && freedAfter(uid, e, 2) && freedAfter(uid, e, 3);
    }

    function registrationOk(rid, r, e) {
      return isEvent(e)
        && r.keys().hasOnly(['uid', 'cubycId', 'name', 'slug', 'kind', 'teamId', 'createdAt'])
        && r.uid == request.auth.uid
        && rid == r.slug + '_' + request.auth.uid
        && r.cubycId == me().cubycId
        && r.name == me().profile.name
        && r.createdAt == request.time
        && allBookedAfter(request.auth.uid, r.slug, e)
        && (
          (e[0] == 'i' && r.kind == 'individual' && !('teamId' in r))
          || (e[0] == 't' && r.kind == 'team' && r.teamId is string && teamHasMeAfter(r.teamId, r.slug))
        );
    }
    function teamHasMeAfter(teamId, slug) {
      return existsAfter(teamPath(teamId)) && getAfter(teamPath(teamId)).data.slug == slug
        && getAfter(teamPath(teamId)).data.status == 'active' && request.auth.uid in getAfter(teamPath(teamId)).data.memberUids;
    }
    function bookingOk(bid, b, e) {
      return isEvent(e)
        && b.keys().hasOnly(['uid', 'slug', 'block', 'at'])
        && b.uid == request.auth.uid
        && b.block is string && b.block.matches('^d[0-9]-[0-9]{4}$') && e.hasAny([b.block])
        && bid == request.auth.uid + '_' + b.block
        && b.at == request.time
        && existsAfter(regPath(b.slug, request.auth.uid));
    }

    // The team a leader is taking apart (status 'dismantling'), while registration is open.
    function dismantlingByMe(teamId) {
      let t = get(teamPath(teamId)).data;
      return viaGoogle() && regOpen() && t.leaderUid == request.auth.uid && t.status == 'dismantling';
    }

    // ---- Site settings and announcements (admin portal, /festadmin) ----------------------
    //   settings/site        { maintenance, message } — anyone may read (the public site checks it)
    //   settings/payment     fees and how to pay — read by signed-in participants
    //   announcements/{id}   published ones are public; drafts only for admins
    function stamped(d) { return d.updatedBy == myEmail() && d.updatedAt == request.time; }
    function str(d, k, max) { return k in d && d[k] is string && d[k].size() <= max; }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }

    match /settings/site {
      allow get: if true;
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['maintenance', 'message', 'updatedBy', 'updatedAt'])
        && request.resource.data.maintenance is bool
        && str(request.resource.data, 'message', 400)
        && stamped(request.resource.data);
      allow delete: if false;
    }

    match /settings/payment {
      allow get: if viaGoogle();
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['open', 'christite', 'external', 'payee', 'upiId', 'bank', 'account', 'ifsc', 'portalUrl', 'instructions', 'updatedBy', 'updatedAt'])
        && request.resource.data.open is bool
        && request.resource.data.christite is int && request.resource.data.christite >= 0 && request.resource.data.christite <= 100000
        && request.resource.data.external is int && request.resource.data.external >= 0 && request.resource.data.external <= 100000
        && optStr(request.resource.data, 'payee', 120) && optStr(request.resource.data, 'upiId', 80)
        && optStr(request.resource.data, 'bank', 120) && optStr(request.resource.data, 'account', 40)
        && optStr(request.resource.data, 'ifsc', 20) && optStr(request.resource.data, 'portalUrl', 300)
        && optStr(request.resource.data, 'instructions', 1500)
        && stamped(request.resource.data);
      allow delete: if false;
    }

    match /announcements/{id} {
      allow get: if (resource != null && resource.data.published == true) || isAdmin();
      allow list: if resource.data.published == true || isAdmin();
      allow create, update: if isSuperAdmin()
        && id.matches('^[A-Za-z0-9_-]{6,40}$')
        && request.resource.data.keys().hasOnly(['title', 'body', 'tag', 'pinned', 'published', 'link', 'date', 'updatedBy', 'updatedAt'])
        && str(request.resource.data, 'title', 140) && request.resource.data.title.size() > 0
        && str(request.resource.data, 'body', 3000)
        && str(request.resource.data, 'tag', 24)
        && request.resource.data.pinned is bool && request.resource.data.published is bool
        && (!('link' in request.resource.data) || request.resource.data.link == '' || (request.resource.data.link is string && request.resource.data.link.size() <= 300 && request.resource.data.link.matches('^(https://|/)[^ <>"]*$')))
        && request.resource.data.date is string && request.resource.data.date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && stamped(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /settings/registration {
      allow get: if viaGoogle();
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['open', 'updatedBy', 'updatedAt'])
        && request.resource.data.open is bool
        && request.resource.data.updatedBy == myEmail()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /registrations/{rid} {
      allow get: if viaGoogle() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (viaGoogle() && resource.data.uid == request.auth.uid);

      // Register yourself: an individual event, or a team event as you create / join its team.
      allow create: if eligible() && regOpen()
        && request.resource.data.slug is string
        && registrationOk(rid, request.resource.data, ev(request.resource.data.slug));

      allow update: if false;

      // Withdraw from an individual event (while open), freeing its time blocks.
      allow delete: if viaGoogle() && regOpen()
        && resource.data.uid == request.auth.uid
        && resource.data.kind == 'individual'
        && allFreedAfter(request.auth.uid, resource.data.slug);
      // A leader taking their team apart removes each member's registration (and blocks).
      allow delete: if resource.data.kind == 'team'
        && dismantlingByMe(resource.data.teamId)
        && (!existsAfter(teamPath(resource.data.teamId)) || !(resource.data.uid in getAfter(teamPath(resource.data.teamId)).data.memberUids))
        && allFreedAfter(resource.data.uid, resource.data.slug);
      allow delete: if isSuperAdmin();
    }

    match /busy/{bid} {
      allow get: if viaGoogle() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (viaGoogle() && resource.data.uid == request.auth.uid);

      // Book one of your own blocks — only together with that event's registration.
      // A block already booked is refused (it exists), which is what stops clashes.
      allow create: if eligible() && regOpen()
        && request.resource.data.slug is string
        && bookingOk(bid, request.resource.data, ev(request.resource.data.slug));

      allow update: if false;

      // Freed together with its registration (withdrawal, or a leader dismantling the team).
      allow delete: if viaGoogle() && regOpen()
        && resource.data.uid == request.auth.uid
        && !existsAfter(regPath(resource.data.slug, request.auth.uid));
      allow delete: if exists(regPath(resource.data.slug, resource.data.uid))
        && get(regPath(resource.data.slug, resource.data.uid)).data.kind == 'team'
        && dismantlingByMe(get(regPath(resource.data.slug, resource.data.uid)).data.teamId)
        && !existsAfter(regPath(resource.data.slug, resource.data.uid));
      allow delete: if isSuperAdmin();
    }

    match /teams/{teamId} {
      // Anyone signed in who has the team code can see the team (to join it). Admins can list.
      allow get: if viaGoogle();
      allow list: if isAdmin();

      // Create a team: you lead it, its name is unique in the event, and you're booked in it.
      allow create: if eligible() && regOpen()
        && teamId.matches('^TM-[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{6}$')
        && request.resource.data.keys().hasOnly(['id', 'slug', 'name', 'nameKey', 'leaderUid', 'leaderCubycId', 'leaderName', 'members', 'memberUids', 'status', 'createdAt'])
        && request.resource.data.id == teamId
        && request.resource.data.slug is string && isTeamEvent(ev(request.resource.data.slug))
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9][A-Za-z0-9 ._&\'-]{1,39}$')
        && !request.resource.data.name.matches('.*  .*')
        && request.resource.data.name == request.resource.data.name.trim()
        && request.resource.data.nameKey == request.resource.data.name.lower()
        && request.resource.data.leaderUid == request.auth.uid
        && request.resource.data.leaderCubycId == me().cubycId
        && request.resource.data.leaderName == me().profile.name
        && request.resource.data.members == [myEntry()]
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && existsAfter(namePath(request.resource.data.slug, request.resource.data.nameKey))
        && getAfter(namePath(request.resource.data.slug, request.resource.data.nameKey)).data.teamId == teamId
        && existsAfter(regPath(request.resource.data.slug, request.auth.uid));

      // Join with the code: add only yourself, while there's room, booked in the same write.
      allow update: if eligible() && regOpen()
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
        && !(request.auth.uid in resource.data.memberUids)
        && resource.data.memberUids.size() < int(ev(resource.data.slug)[1])
        && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.members == resource.data.members.concat([myEntry()])
        && existsAfter(regPath(resource.data.slug, request.auth.uid))
        && getAfter(regPath(resource.data.slug, request.auth.uid)).data.teamId == teamId;

      // The leader starts taking the team apart (no one can join from then on)…
      allow update: if viaGoogle() && regOpen()
        && resource.data.leaderUid == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'dismantling';
      // …removes one member at a time (their registration is deleted in the same write)…
      allow update: if viaGoogle() && regOpen()
        && resource.data.leaderUid == request.auth.uid
        && resource.data.status == 'dismantling'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
        && resource.data.memberUids.removeAll(request.resource.data.memberUids).size() == 1
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && request.resource.data.members.size() == request.resource.data.memberUids.size()
        && !(resource.data.memberUids.removeAll(request.resource.data.memberUids)[0] == request.auth.uid)
        && !existsAfter(regPath(resource.data.slug, resource.data.memberUids.removeAll(request.resource.data.memberUids)[0]));
      // …and finally deletes it, with their own registration and the team name.
      allow delete: if viaGoogle() && regOpen()
        && resource.data.leaderUid == request.auth.uid
        && resource.data.status == 'dismantling'
        && resource.data.memberUids == [request.auth.uid]
        && !existsAfter(regPath(resource.data.slug, request.auth.uid))
        && !existsAfter(namePath(resource.data.slug, resource.data.nameKey));

      // Super admins: fix anything (logged by the admin portal).
      allow update: if isSuperAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'members', 'memberUids'])
        && request.resource.data.status in ['active', 'dismantling'];
      allow delete: if isSuperAdmin();
    }

    match /teamNames/{key} {
      allow get: if viaGoogle();
      allow list: if isAdmin();
      // Claimed together with creating the team.
      allow create: if eligible() && regOpen()
        && request.resource.data.keys().hasOnly(['teamId'])
        && existsAfter(teamPath(request.resource.data.teamId))
        && !exists(teamPath(request.resource.data.teamId))
        && getAfter(teamPath(request.resource.data.teamId)).data.leaderUid == request.auth.uid
        && key == getAfter(teamPath(request.resource.data.teamId)).data.slug + '_' + getAfter(teamPath(request.resource.data.teamId)).data.nameKey;
      allow update: if false;
      allow delete: if exists(teamPath(resource.data.teamId)) && dismantlingByMe(resource.data.teamId)
        && !existsAfter(teamPath(resource.data.teamId));
      allow delete: if isSuperAdmin();
    }

    // Everything else: closed.
    match /{document=**} { allow read, write: if false; }
  }
}
