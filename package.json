{
  "name": "cubyc-fest-orbit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-knowledge.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "knowledge": "node scripts/build-knowledge.mjs",
    "emulators": "firebase emulators:start --project demo-cubyc --only auth,firestore",
    "test:backend": "node scripts/build-rules.mjs && firebase emulators:exec --project demo-cubyc --only auth,firestore \"node --test --test-concurrency=1 emulator-tests/rules.spec.mjs emulator-tests/account.spec.mjs emulator-tests/events.spec.mjs\"",
    "dev:emulator": "vite --mode emulator",
    "rules": "node scripts/build-rules.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "firebase": "^11.10.0",
    "gsap": "^3.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/vite": "^4.1.7",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.7",
    "vite": "^6.3.5"
  }
}
